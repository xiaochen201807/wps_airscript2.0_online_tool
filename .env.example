# ==========================================
# WPS AirScript 2.0 在线工具 - 环境配置模版
# 使用说明：复制本文件并重命名为 .env，填入您自己的真实配置信息
# ==========================================

# API 基础地址（默认直连金山文档 https://www.kdocs.cn）
# 🌟 若在公司内网禁用了 kdocs.cn，可填入 Cloudflare Worker 反代地址：
# WPS_BASE_URL="https://wps-proxy.yourname.workers.dev"
WPS_BASE_URL="https://www.kdocs.cn"

# 通用 AirScript Token 令牌（在 WPS 脚本编辑器中点击「脚本令牌」获取）
WPS_TOKEN="your_token_here"

# 资产负债表（验证演示表）配置
BALANCE_SHEET_FILE_ID="your_balance_sheet_file_id"
BALANCE_SHEET_SCRIPT_ID="your_balance_sheet_script_id"

# 周计划/工时表配置
WORKHOURS_FILE_ID="your_workhours_file_id"
WORKHOURS_SCRIPT_ID="your_workhours_script_id"

# 默认查询的负责人姓名
DEFAULT_PERSON_NAME="张三"
